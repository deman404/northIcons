<Window x:Class="NorthIcons.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NorthIcons" Title="northIcons — your local icon library" Width="1440" Height="920" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F7F9FA" Foreground="#172B38" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Grid Background="#F7F9FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="#E6EBEE" BorderThickness="0,0,1,0">
   <Grid Margin="20,28,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="8,0,0,38"><Border Background="#087F8C" CornerRadius="10" Width="34" Height="34"><local:UiIcon NameKey="north" Foreground="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="northIcons" FontSize="22" FontWeight="Bold" Margin="9,2,0,0"/></StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="#94A0A8" FontSize="10" FontWeight="SemiBold" Margin="15,0,0,12"/>
     <Button x:Name="AllNav" Style="{StaticResource Nav}" Click="All_Click"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="apps" Margin="0,0,12,0"/><TextBlock Text="All icons" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="FavoritesNav" Style="{StaticResource Nav}" Click="Favorites_Click"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="heart" Margin="0,0,12,0"/><TextBlock Text="Favorites" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="RecentNav" Style="{StaticResource Nav}" Click="Recent_Click"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="clock" Margin="0,0,12,0"/><TextBlock Text="Recently used" VerticalAlignment="Center"/></StackPanel></Button>
     <Border Height="1" Background="#EDF0F2" Margin="10,24"/>
     <TextBlock Text="YOUR LIBRARY" Foreground="#94A0A8" FontSize="10" FontWeight="SemiBold" Margin="15,0,0,12"/>
     <Button Style="{StaticResource Nav}" Click="Library_Click"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="folder" Margin="0,0,12,0"/><TextBlock Text="Change folder" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}" Click="Refresh_Click"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="refresh" Margin="0,0,12,0"/><TextBlock Text="Refresh icons" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <Border Grid.Row="2" Background="#F1F7F7" CornerRadius="12" Padding="15"><StackPanel><TextBlock Text="Made for your next idea." FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Your icons. Your projects.&#10;One quiet little workspace." FontSize="11" Foreground="#73818B" Margin="0,8,0,0" LineHeight="19"/><TextBlock Text="LOCAL LIBRARY  •  OFFLINE" FontSize="9" Foreground="#087F8C" FontWeight="SemiBold" Margin="0,16,0,0"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,28,26,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,26"><TextBlock Text="THE ICON WORKSPACE" Foreground="#087F8C" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="White" BorderBrush="#E3E8EB" BorderThickness="1" CornerRadius="20" Padding="12,6" HorizontalAlignment="Right"><TextBlock x:Name="LibraryCount" Text="Loading library…" FontSize="11" Foreground="#73818B"/></Border></DockPanel>
   <StackPanel Grid.Row="1"><TextBlock x:Name="Heading" Text="Find your next icon." FontSize="32" FontWeight="SemiBold"/><TextBlock Text="A little detail. A big difference." Foreground="#73818B" FontSize="13" Margin="0,8,0,22"/>
    <Border Background="White" CornerRadius="11" BorderBrush="#DAE3E7" BorderThickness="1" Padding="16,13"><DockPanel><local:UiIcon NameKey="search" Foreground="#087F8C" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="Ctrl + F" Foreground="#97A3AC" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/><Grid><TextBox x:Name="Search" BorderThickness="0" Background="Transparent" FontSize="15" VerticalContentAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="Search icons"/><TextBlock x:Name="SearchHint" Text="Search icons, e.g. home, arrow, music…" Foreground="#97A3AC" FontSize="15" IsHitTestVisible="False"/></Grid></DockPanel></Border>
   </StackPanel>
   <StackPanel Grid.Row="2" Margin="0,18,0,16"><WrapPanel x:Name="Topics"/><DockPanel Margin="0,20,0,0"><TextBlock x:Name="ResultCount" Text="Indexing your SVGs…" FontSize="12" Foreground="#73818B"/><TextBlock Text="Click an icon to explore" FontSize="11" Foreground="#97A3AC" HorizontalAlignment="Right"/></DockPanel></StackPanel>
   <Grid Grid.Row="3">
    <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="IconGrid"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="116" Height="126" Margin="0,0,10,10" Padding="8" Tag="{Binding}" Click="Icon_Click" ToolTip="{Binding Title}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#E9F6F5"/><Setter Property="BorderBrush" Value="#087F8C"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><Image Source="{Binding Preview}" Width="35" Height="35" Margin="0,10,0,19"/><TextBlock Text="{Binding Title}" Width="96" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <TextBlock x:Name="EmptyState" Visibility="Collapsed" Text="No icons found. Try a different search." FontSize="17" Foreground="#73818B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
   <DockPanel Grid.Row="4" Margin="0,15,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="Previous"  Click="Previous_Click" Padding="12,7"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="left" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="Previous"/></StackPanel></Button><TextBlock x:Name="PageLabel" Text="Page 1" Margin="14,0" VerticalAlignment="Center" FontSize="12"/><Button x:Name="Next"  Click="Next_Click" Padding="12,7"><StackPanel Orientation="Horizontal"><TextBlock Text="Next"/><local:UiIcon NameKey="right" Width="12" Height="12" Margin="7,0,0,0"/></StackPanel></Button></StackPanel><TextBlock x:Name="Status" Text="Ready" TextTrimming="CharacterEllipsis" Foreground="#087F8C" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="290"/></DockPanel>
  </Grid>
  <Border Grid.Column="2" Background="White" BorderBrush="#E6EBEE" BorderThickness="1,0,0,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="23,30,23,24">
    <DockPanel><TextBlock Text="ICON DETAILS" FontSize="10" Foreground="#94A0A8" FontWeight="SemiBold"/><TextBlock Text="SVG" FontSize="10" Foreground="#087F8C" HorizontalAlignment="Right"/></DockPanel>
    <Border x:Name="PreviewSurface" Height="202" Background="#F4F8F8" CornerRadius="14" Margin="0,23,0,20"><Image x:Name="LargePreview" Width="92" Height="92"/></Border>
    <TextBlock x:Name="IconTitle" Text="Pick something good." FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="IconMeta" Text="Select an icon from the library." Foreground="#73818B" FontSize="11" Margin="0,8,0,17" TextWrapping="Wrap"/>
    <TextBlock x:Name="PreviewWarning" Foreground="#A9631B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel x:Name="IconActions" IsEnabled="False">
     <Button x:Name="CopySvgButton" Style="{StaticResource Primary}" Click="CopySvg_Click" Margin="0,0,0,9"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="copy" Margin="0,0,9,0"/><TextBlock Text="Copy SVG"/><TextBlock Text="Ctrl + C" Opacity="0.7" Margin="35,0,0,0" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
     <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Click="CopyFile_Click" Padding="8,10"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="file" Width="13" Height="13" Margin="0,0,7,0"/><TextBlock Text="Copy file"/></StackPanel></Button><Button Grid.Column="2" Click="Export_Click" Padding="8,10"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="download" Width="13" Height="13" Margin="0,0,7,0"/><TextBlock Text="SVG"/></StackPanel></Button></Grid>
     <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><Button x:Name="PngButton" Click="ExportPng_Click"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="download" Width="14" Height="14" Margin="0,0,8,0"/><TextBlock Text="PNG"/></StackPanel></Button><ComboBox x:Name="PngSize" Grid.Column="2" SelectedIndex="3" VerticalContentAlignment="Center" AutomationProperties.Name="PNG size"><ComboBoxItem Content="64 px" Tag="64"/><ComboBoxItem Content="128 px" Tag="128"/><ComboBoxItem Content="256 px" Tag="256"/><ComboBoxItem Content="512 px" Tag="512"/><ComboBoxItem Content="1024 px" Tag="1024"/><ComboBoxItem Content="2048 px" Tag="2048"/></ComboBox></Grid><Button x:Name="FavoriteButton" Click="Favorite_Click" Margin="0,0,0,22"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="heart" Margin="0,0,9,0"/><TextBlock x:Name="FavoriteLabel" Text="Add to favorites"/></StackPanel></Button>
     <StackPanel Margin="0,0,0,20"><DockPanel Margin="0,0,0,10"><TextBlock Text="ICON COLOR" FontSize="10" Foreground="#94A0A8" FontWeight="SemiBold"/><Button Content="Reset" Click="ResetColor_Click" FontSize="10" Padding="7,3" HorizontalAlignment="Right"/></DockPanel><WrapPanel x:Name="ColorSwatches" Margin="0,0,0,10"/><Border Background="White" CornerRadius="7" BorderBrush="#E3E8EB" BorderThickness="1" Padding="10,8"><Grid><TextBox x:Name="HexColor" BorderThickness="0" Background="Transparent" FontSize="12" MaxLength="7" TextChanged="Color_Changed" ToolTip="Custom icon color (#RGB or #RRGGBB)" AutomationProperties.Name="Custom icon hex color"/><TextBlock Text="#RRGGBB" FontSize="12" Foreground="#94A0A8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HexColor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border><TextBlock x:Name="ColorNote" Text="Original colors · copies and exports" FontSize="10" Foreground="#73818B" Margin="0,7,0,0"/></StackPanel><TextBlock Text="PREVIEW SIZE" FontSize="10" Foreground="#94A0A8" FontWeight="SemiBold"/>
     <Slider x:Name="PreviewSize" Minimum="32" Maximum="150" Value="92" Margin="0,13,0,24" ValueChanged="Size_Changed" AutomationProperties.Name="Preview size"/>
    </StackPanel>
    <Border Background="#F7F9FA" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="YOUR PROJECT" FontSize="10" Foreground="#94A0A8" FontWeight="SemiBold"/><TextBlock x:Name="ProjectLabel" Text="Choose a folder once. Add icons&#10;with a single click." TextWrapping="Wrap" FontSize="11" Foreground="#73818B" Margin="0,10,0,12"/><Button Click="Project_Click" FontSize="11" Padding="10,8"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="folder" Width="13" Height="13" Margin="0,0,8,0"/><TextBlock Text="Choose project folder"/></StackPanel></Button><Button x:Name="AddProjectButton"  Click="AddProject_Click" IsEnabled="False" Style="{StaticResource Primary}" Margin="0,9,0,0" FontSize="12"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="plus" Width="13" Height="13" Margin="0,0,8,0"/><TextBlock Text="Add to project"/></StackPanel></Button></StackPanel></Border>
    <Button x:Name="SourceButton"  Click="Source_Click" IsEnabled="False" BorderThickness="0" Foreground="#73818B" Margin="0,17,0,0" FontSize="11"><StackPanel Orientation="Horizontal"><local:UiIcon NameKey="link" Width="12" Height="12" Margin="0,0,8,0"/><TextBlock Text="View source &amp; license"/></StackPanel></Button>
    <TextBlock Text="Color applies to copies and exports.&#10;Flaticon attribution requirements apply." TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Foreground="#94A0A8" LineHeight="17" Margin="0,8,0,0"/>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</Window>






